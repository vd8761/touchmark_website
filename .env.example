# Copy to .env.local and fill in. Never commit the real values.
# See CMS_INTEGRATION_GUIDE.md §9.

# Base URL of the CMS API. No trailing slash.
CMS_API_URL=http://localhost:4000

# Delivery API key, scopes: content.read, media.read, search.read.
# Must be a SECRET key (sk_test_… / sk_live_…) and must NOT be prefixed
# NEXT_PUBLIC_ — that prefix would inline it into the browser bundle.
CMS_API_KEY=

# Signing secret of the CMS "Next.js revalidation" webhook (whsec_…).
# Verifies calls to /api/revalidate.
CMS_WEBHOOK_SECRET=

# Workspace uuid. Only needed by scripts/migrate-articles.mjs, not at runtime.
CMS_WORKSPACE_ID=

# --- Transactional email (contact form + e-book downloads) ---

# Resend API key. Without it /api/contact and /api/ebook return 500.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@touchmarkdes.com

# Where enquiries land. CONTACT_CC_EMAIL / CONTACT_BCC_EMAIL accept comma-separated lists.
CONTACT_TO_EMAIL=info@touchmarkdes.com
CONTACT_CC_EMAIL=
CONTACT_BCC_EMAIL=

# E-book download requests. Falls back to CONTACT_TO_EMAIL when unset.
EBOOK_TO_EMAIL=

# Public URL of each e-book file, keyed by the `?ebook_content_id=` in the page URL.
# When one is unset the requester is told the team will email the file, and the
# team notification flags that it needs sending manually.
EBOOK_DOWNLOAD_URL_1=
EBOOK_DOWNLOAD_URL_2=
EBOOK_DOWNLOAD_URL_3=
